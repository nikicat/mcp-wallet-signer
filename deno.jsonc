{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "tasks": {
    "build:all": "cd packages/browser-evm-signer && deno task build:npm && cd ../mcp-wallet-signer && deno task build:npm",
    "test:all": "cd packages/browser-evm-signer && deno task test",
    "check:all": "cd packages/browser-evm-signer && deno task check && cd ../mcp-wallet-signer && deno task check",
    "install:all": "cd packages/browser-evm-signer && deno task install:all",
    "fmt": "cd packages/browser-evm-signer && deno task fmt && cd ../mcp-wallet-signer && deno task fmt",
    "lint": "cd packages/browser-evm-signer && deno task lint && cd ../mcp-wallet-signer && deno task lint"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 130,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
