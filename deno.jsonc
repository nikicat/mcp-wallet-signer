{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  // Declare a Deno workspace so the root `cli` task can import from the per-package tools/
  // and have each member's `imports` map (notably `wallet-signer-core`) resolved transparently.
  "workspace": [
    "./packages/wallet-signer-core",
    "./packages/browser-evm-signer",
    "./packages/browser-tron-signer",
    "./packages/mcp-wallet-signer"
  ],
  "tasks": {
    "cli": "deno run -A tools/signer-cli.ts",
    "build:all": "cd packages/wallet-signer-core && deno task build:npm && cd ../browser-evm-signer && deno task build:npm && cd ../browser-tron-signer && deno task build:npm && cd ../mcp-wallet-signer && deno task build:npm",
    "test:all": "cd packages/wallet-signer-core && deno task test && cd ../browser-evm-signer && deno task test && cd ../browser-tron-signer && deno task test",
    "check:all": "cd packages/wallet-signer-core && deno task check && cd ../browser-evm-signer && deno task check && cd ../browser-tron-signer && deno task check && cd ../mcp-wallet-signer && deno task check",
    "install:all": "cd packages/wallet-signer-core && deno install && cd ../browser-evm-signer && deno task install:all && cd ../browser-tron-signer && deno task install:all && cd ../mcp-wallet-signer && deno install",
    "fmt": "deno fmt tools/ && cd packages/wallet-signer-core && deno task fmt && cd ../browser-evm-signer && deno task fmt && cd ../browser-tron-signer && deno task fmt && cd ../mcp-wallet-signer && deno task fmt",
    "lint": "deno lint tools/ && cd packages/wallet-signer-core && deno task lint && cd ../browser-evm-signer && deno task lint && cd ../browser-tron-signer && deno task lint && cd ../mcp-wallet-signer && deno task lint"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 130,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "nodeModulesDir": "auto"
}
