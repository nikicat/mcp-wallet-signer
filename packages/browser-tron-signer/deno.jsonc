{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "name": "@nikicat/browser-tron-signer",
  "version": "0.1.0",
  "description": "Route TRON wallet signing requests to browser wallets like TronLink via a local HTTP bridge",
  "license": "MIT",
  "exports": "./src/mod.ts",
  // npm package metadata (read by scripts/build-npm.ts; version comes from top-level field)
  "npm": {
    "name": "browser-tron-signer",
    "description": "Route TRON transactions to browser wallets for signing — standalone library, no MCP dependency",
    "author": "Nikolay Bryskin",
    "license": "MIT",
    "repository": { "type": "git", "url": "https://github.com/nikicat/mcp-wallet-signer" },
    "engines": { "node": ">=18" },
    "keywords": [
      "wallet",
      "tron",
      "tronlink",
      "tronweb",
      "browser-wallet",
      "signing",
      "blockchain",
      "tip-712",
      "non-custodial",
      "transaction-signing"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "ES2022"]
  },
  "imports": {
    "wallet-signer-core": "../wallet-signer-core/src/mod.ts",
    "open": "npm:open@11.0.0",
    "@types/node": "npm:@types/node@25.5.0"
  },
  "permissions": {
    "build-npm": {
      "read": true,
      "write": true,
      "env": true,
      "run": true,
      "net": true
    },
    "test": {
      "read": true,
      "env": true,
      "net": true,
      "run": true,
      "sys": true
    }
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-run --allow-sys src/mod.ts",
    "gen:web-ui": "deno run -A scripts/gen-web-ui.ts",
    "build:npm": "deno run -P=build-npm scripts/build-npm.ts",
    "test": "deno test -P=test tests/",
    "check": "deno check src/ tests/ scripts/ && deno lint src/ tests/ scripts/ && deno fmt --check src/ tests/ scripts/ && deno run -A npm:htmlhint src/index.html && deno run -A scripts/gen-web-ui.ts && git diff --quiet src/web-ui.gen.ts",
    "fmt": "deno fmt src/ tests/ scripts/",
    "lint": "deno lint src/ tests/"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 130,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "nodeModulesDir": "auto",
  "exclude": ["dist/", "npm/"],
  "publish": {
    "exclude": ["tests/", "scripts/", "deno.lock"]
  }
}
