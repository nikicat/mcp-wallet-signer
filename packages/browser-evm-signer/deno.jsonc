{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "name": "@nikicat/browser-evm-signer",
  "version": "0.2.1",
  "description": "Route EVM wallet signing requests to browser wallets like MetaMask via a local HTTP bridge",
  "license": "MIT",
  "exports": "./src/mod.ts",
  // npm package metadata (read by scripts/build-npm.ts; version comes from top-level field)
  "npm": {
    "name": "browser-evm-signer",
    "description": "Route EVM transactions to browser wallets for signing — standalone library, no MCP dependency",
    "author": "Nikolay Bryskin",
    "license": "MIT",
    "repository": { "type": "git", "url": "https://github.com/nikicat/mcp-wallet-signer" },
    "engines": { "node": ">=18" },
    "keywords": [
      "wallet",
      "ethereum",
      "evm",
      "metamask",
      "eip-6963",
      "browser-wallet",
      "signing",
      "blockchain",
      "web3",
      "non-custodial",
      "transaction-signing",
      "viem"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "ES2022"]
  },
  "imports": {
    // JSR specifier so `deno publish` accepts it; the Deno workspace resolves it to local
    // source during dev/build (wallet-signer-core is a workspace member with this name).
    "wallet-signer-core": "jsr:@nikicat/wallet-signer-core@^0.1.0",
    "viem": "npm:viem@^2.48.4",
    "viem/": "npm:viem@^2.48.4/",
    "open": "npm:open@11.0.0",
    "@std/http": "jsr:@std/http@1.0.25",
    "@types/node": "npm:@types/node@25.5.0"
  },
  "permissions": {
    "build-npm": { "read": true, "write": true, "env": true, "run": true, "net": true },
    "test": { "read": true, "env": true, "net": true, "run": true, "sys": true },
    "test-e2e": { "read": true, "env": true, "net": true, "run": true }
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-run --allow-sys src/mod.ts",
    "trigger": "deno run -A tools/trigger.ts",
    "gen:web-ui": "deno run -A scripts/gen-web-ui.ts",
    "build:npm": "deno run -P=build-npm scripts/build-npm.ts",
    "test": "deno test -P=test tests/",
    "test:e2e": "deno test -P=test-e2e tests/e2e/",
    "test:browser": "cd tests/e2e-browser && deno task test",
    "test:browser:ui": "cd tests/e2e-browser && deno task test:ui",
    // Pin to the version used by the e2e tests (tests/e2e-browser/deno.json) — `@latest` will
    // install a Chromium build that mismatches the test runtime if npm releases a new minor.
    "playwright:install": "deno run -A npm:@playwright/test@1.60.0/cli install chromium",
    "install:all": "deno install && cd tests/e2e-browser && deno install",

    // `deno lint` / `deno fmt` (no args) walk the include lists from the fmt/lint config blocks
    // below. The `--ignore=tests/e2e-browser` flag is repeated because workspace mode appears
    // to bypass the config-level `exclude` for that nested workspace member; the CLI flag is
    // the reliable way to keep parent lint/fmt out of the child member's tree.
    "check:types": "deno check src/ tests/*.test.ts tests/e2e/ tests/fixtures/ scripts/ tools/",
    "check:lint": "deno lint --ignore=tests/e2e-browser",
    "check:fmt": "deno fmt --check --ignore=tests/e2e-browser",
    "check:html": "deno run -A npm:htmlhint src/index.html",
    "check:gen-ui": "deno run -A scripts/gen-web-ui.ts && git diff --quiet src/web-ui.gen.ts",
    "check": "deno task check:types && deno task check:lint && deno task check:fmt && deno task check:html && deno task check:gen-ui",
    "fmt": "deno fmt --ignore=tests/e2e-browser",
    "lint": "deno lint --ignore=tests/e2e-browser"
  },
  "fmt": {
    "include": ["src/", "tests/", "scripts/", "tools/"],
    "useTabs": false,
    "lineWidth": 130,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "include": ["src/", "tests/", "tools/"],
    "rules": { "tags": ["recommended"] }
  },
  "publish": {
    "exclude": ["tests/", "scripts/", "docs/", "deno.lock"]
  }
}
