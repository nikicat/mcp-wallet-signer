{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "name": "@nikicat/browser-evm-signer",
  "version": "0.1.8",
  "license": "MIT",
  "exports": "./src/mod.ts",
  // npm package metadata (read by scripts/build-npm.ts; version comes from top-level field)
  "npm": {
    "name": "browser-evm-signer",
    "description": "Route EVM transactions to browser wallets for signing — standalone library, no MCP dependency",
    "author": "Nikolay Bryskin",
    "license": "MIT",
    "repository": { "type": "git", "url": "https://github.com/nikicat/mcp-wallet-signer" },
    "engines": { "node": ">=18" },
    "keywords": [
      "wallet", "ethereum", "evm", "metamask", "eip-6963", "browser-wallet",
      "signing", "blockchain", "web3", "non-custodial", "transaction-signing", "viem"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "ES2022"]
  },
  "imports": {
    "viem": "npm:viem@2.46.2",
    "viem/": "npm:viem@2.46.2/",
    "open": "npm:open@10.1.0",
    "@std/http": "jsr:@std/http@1.0.10",
    "@types/node": "npm:@types/node@22.5.0"
  },
  "permissions": {
    "build-npm": {
      "read": true,
      "write": true,
      "env": true,
      "run": true,
      "net": true
    },
    "test": {
      "read": true,
      "env": true,
      "net": true,
      "run": true,
      "sys": true
    },
    "test-e2e": {
      "read": true,
      "env": true,
      "net": true,
      "run": true
    }
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-run --allow-sys src/mod.ts",
    "gen:web-ui": "deno run -A scripts/gen-web-ui.ts",
    "build:npm": "deno run -P=build-npm scripts/build-npm.ts",
    "test": "deno test -P=test tests/",
    "test:e2e": "deno test -P=test-e2e tests/e2e/",
    "test:browser": "cd tests/e2e-browser && deno task test",
    "test:browser:ui": "cd tests/e2e-browser && deno task test:ui",
    "playwright:install": "deno run -A npm:@playwright/test@latest/cli install chromium",
    "install:all": "deno install && deno install --config tests/e2e-browser/deno.json",
    "check": "deno check src/ tests/ scripts/ && deno lint src/ tests/ scripts/ && deno fmt --check src/ tests/ scripts/ && deno run -A npm:htmlhint src/index.html && deno run -A scripts/gen-web-ui.ts && git diff --quiet src/web-ui.ts",
    "fmt": "deno fmt src/ tests/ scripts/",
    "lint": "deno lint src/ tests/"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 130,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "nodeModulesDir": "auto",
  "exclude": ["dist/", "npm/", "tests/e2e-browser/"],
  "publish": {
    "exclude": ["tests/", "scripts/", "docs/", "deno.lock"]
  }
}
